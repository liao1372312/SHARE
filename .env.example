# OpenAI-compatible chat-completions endpoint for measuring real token usage.
# Copy this file to .env and fill in your own key locally.

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.6-terra

# Optional comparison endpoints for local development helpers.
LLM_BACKBONE_2_BASE_URL=
LLM_BACKBONE_2_API_KEY=
LLM_BACKBONE_2_MODEL=gpt-5.6-luna
LLM_BACKBONE_2_REASONING_EFFORT=low

LLM_BACKBONE_3_BASE_URL=
LLM_BACKBONE_3_API_KEY=
LLM_BACKBONE_3_MODEL=gpt-5.6-terra
LLM_BACKBONE_3_REASONING_EFFORT=low
